<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CapturePro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/bg_header</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <!-- Colors for Material components -->
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorPrimaryVariant">@color/accent_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Text -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- Edit text cursor / highlight -->
        <item name="colorControlActivated">@color/accent_orange</item>
        <item name="colorControlHighlight">#33FF6D00</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Spinner background — dark with subtle border + drop arrow look -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#22304A"/>
            <stroke android:width="1dp" android:color="@color/accent_orange"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/input_bg"/>
            <stroke android:width="1dp" android:color="@color/input_stroke"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
</selector>

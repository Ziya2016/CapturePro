<?xml version="1.0" encoding="utf-8"?>
<!-- Dark rounded input field with subtle border -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/input_bg"/>
            <stroke android:width="1.5dp" android:color="@color/accent_orange"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/input_bg"/>
            <stroke android:width="1dp" android:color="@color/input_stroke"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
</selector>

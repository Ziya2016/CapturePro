<?xml version="1.0" encoding="utf-8"?>
<!-- Orange solid/gradient background for Create Account button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#E65100"
                android:endColor="#FF6D00"
                android:angle="0"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#444455"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#FF6D00"
                android:endColor="#FF8F00"
                android:angle="0"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
</selector>
